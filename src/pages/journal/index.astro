---
import { ArrowLeft, Wrench } from "@lucide/astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Journal.WIP — Dennis Mithamo"
  description="Dennis Mithamo's journal — currently under construction."
>
  <div class="min-h-[60vh] flex items-center justify-center">
    <div class="w-full max-w-2xl">
      <div class="rounded-2xl border border-grid-major bg-background/70 backdrop-blur-md overflow-hidden shadow-xl">
        <div class="flex items-center gap-3 px-5 py-4 border-b border-grid-major">
          <Wrench size={18} class="text-accent" stroke-width={2} />

          <h1 class="font-bold text-text-primary">Journal.WIP</h1>
        </div>

        <div class="p-8">
          <p class="text-2xl font-bold text-text-primary mb-3">
            Construction in Progress
          </p>

          <p class="text-text-secondary leading-relaxed mb-8">
            Working on this, if slowly, because work and school are demanding my
            full attention. Check back soonish.
          </p>

          <div class="rounded-xl bg-black/20 border border-grid-major p-5 font-mono text-sm space-y-2">
            <p class="text-text-secondary">
              <span class="text-accent">[PENDING]</span>
              Fetching drafts...
            </p>

            <p class="text-text-secondary">
              <span class="text-accent">[WARN]</span>
              Developer distracted by the ridiculous requirement to work for a
              living.
            </p>

            <p class="text-text-secondary">
              <span class="text-accent">[INFO]</span>
              ETA: Soon™
            </p>
          </div>

          <div class="mt-8">
            <a
              href="/"
              class="inline-flex items-center gap-2 text-text-secondary hover:text-accent transition-colors"
            >
              <ArrowLeft size={16} stroke-width={2} />
              <span>Return Home</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
